  interface uart_tx_if(input logic clk);
logic Tx_start;
logic [7:0] Tx_Din;
logic Tx_Dout;
logic Tx_Ready;
logic reset;
  
  clocking drv_cb@(posedge clk);
    output Tx_start, Tx_Din;
    input Tx_Dout, Tx_Ready;
  endclocking
    modport DRV (clocking drv_cb, input clk, output reset);
    modport MON (input clk, reset, Tx_start, Tx_Din, Tx_Dout, Tx_Ready);
    endinterface
