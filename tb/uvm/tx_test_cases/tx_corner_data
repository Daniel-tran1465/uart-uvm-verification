module tb_tx_top;
  logic clk = 0;

  always#10 clk = ~clk;
  
  uart_tx_if vif(clk);
  
UART_TX#(
  .tx_data_width(8),
  .tx_sysclkfreq(50000000),
  .tx_baudrate(115200)
)tx_inst(
.clk(clk),
  .reset(vif.reset),
  .Tx_start(vif.Tx_start),
  .Tx_Din(vif.Tx_Din),
  .Tx_Dout(vif.Tx_Dout),
  .Tx_Ready(vif.Tx_Ready)
);
  initial begin
        vif.reset = 1'b1;
    #100 vif.reset = 1'b0;
  end
  
  initial begin
    $dumpfile("dump.vcd");
    $dumpvars(0, tb_tx_top); // Tham số thứ 2 là tên module top của bạn
  end
  
  initial begin
    uvm_config_db#(virtual uart_tx_if.DRV)::set(null, "*", "vif_tx", vif);
    uvm_config_db#(virtual uart_tx_if.MON)::set(null, "*", "vif_tx", vif);
    run_test("uart_tx_test");
    $dumpfile("dump.vcd"); 
    $dumpvars;
  end
  
endmodule
